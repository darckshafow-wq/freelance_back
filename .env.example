# Database Configuration
# PostgreSQL (Production)
DATABASE_URL=postgresql://freelance_user:secure_password@postgres:5432/freelance_db

# SQLite (Local Development - uncomment to use)
# DATABASE_URL=sqlite:///./sql_app.db

POSTGRES_USER=freelance_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=freelance_db

# Application Configuration
PROJECT_NAME=Freelance Platform API v1.1
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_STR=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Environment
ENVIRONMENT=development
